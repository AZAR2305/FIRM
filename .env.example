# Copy to .env (git-ignored) and fill in. TESTNET KEYS ONLY. Never commit a real key.
# Foundry: prefer `cast wallet import firm-deployer --interactive` over a raw key.
DEPLOYER_ACCOUNT=firm-deployer
DEPLOYER_PRIVATE_KEY=                 # alternative to the keystore; deployer == Scoreboard owner == benchmark wallet
DEPLOYER_ADDRESS=

# RPCs, comma separated, primary first (rate limits: QuickNode 25 rps eth_call, Ankr 300/10s, Monad Foundation 20 rps)
MONAD_TESTNET_RPC_URLS=https://testnet-rpc.monad.xyz,https://rpc.ankr.com/monad_testnet,https://rpc-testnet.monadinfra.com
ALCHEMY_MONAD_TESTNET_URL=

# Envio (see envio/README.md). HyperSync needs a free token from https://envio.dev/app/api-tokens; RPC mode does not.
ENVIO_API_TOKEN=
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql
ENVIO_ADMIN_SECRET=testing            # Hasura admin secret of the LOCAL `envio dev` stack

# backend services
QUOTE_API_URL=http://localhost:8787
QUOTE_API_PORT=8787
REPORTS_DIR=./reports                 # canary reports served by quote-api
CANARY_PRIVATE_KEY=                   # canary-agent wallet, testnet only
CANARY_ADDRESS=
CANARY_STATE_PATH=./canary-state.json
TRADER_PRIVATE_KEY=                   # trader-agent / firm-mcp wallet, testnet only
TRADER_ADDRESS=
ARENA_OWNER_PRIVATE_KEY=              # optional: lets the arena reinstate the villain hook between trials
BENCH_PRIVATE_KEY=                    # the deployer/owner key

# any OpenAI-compatible endpoint (Kimi, Qwen, ...). Leave empty to use the deterministic report template and the scripted trader.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# local forks only: FIRM_FORK=1 makes the deployment scripts write deployments/10143.fork.json (git-ignored)
# FIRM_FORK=1
# FIRM_DEPLOYMENTS_PATH=deployments/10143.fork.json
