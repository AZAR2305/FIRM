# Foundry: prefer `cast wallet import firm-deployer --interactive` over a raw key.
DEPLOYER_ACCOUNT=firm-deployer
MONAD_TESTNET_RPC_URLS=https://testnet-rpc.monad.xyz
# Add fallbacks comma-separated: https://rpc.ankr.com/monad_testnet
# and https://rpc-testnet.monadinfra.com (mind each endpoint's rate limits)
ALCHEMY_MONAD_TESTNET_URL=
ENVIO_GRAPHQL_URL=
QUOTE_API_URL=http://localhost:8787
QUOTE_API_PORT=8787
CANARY_PRIVATE_KEY=      # testnet only
TRADER_PRIVATE_KEY=      # testnet only
LLM_BASE_URL=            # any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_MODEL=
CANARY_STATE_PATH=./canary-state.json   # probe schedule + results (JSON file store)
REPORTS_DIR=./reports                    # canary reports served by quote-api
