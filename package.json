{
  "name": "firm",
  "private": true,
  "version": "0.1.0",
  "description": "FIRM: bonded-quote enforcement and a public fill-quality ledger for Uniswap v4 swaps on Monad",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "abis": "node scripts/gen-abis.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "quote-api": "pnpm --filter @firm/quote-api start",
    "canary": "pnpm --filter @firm/canary-agent start",
    "bench": "pnpm --filter @firm/bench start",
    "contracts:test": "cd contracts && forge test",
    "deployments": "node scripts/build-deployments.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
