{
  "name": "@firm/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "FIRM web app: protected vs raw swap with a live timeline, hook leaderboard, integration docs",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-deployments.mjs",
    "dev": "node scripts/sync-deployments.mjs && next dev",
    "build": "node scripts/sync-deployments.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/sync-deployments.mjs && tsc --noEmit",
    "test": "node scripts/sync-deployments.mjs && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.4",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
